# Copy this file to .env and fill in your own values. Never commit .env.

# Supabase project settings -> API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Mapbox public access token (Mapbox account -> Tokens), used by the client at runtime.
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Mapbox SECRET download token (Mapbox account -> Tokens -> Create a token with
# the "Downloads:Read" scope). Only used at build time to fetch the native SDK,
# never bundled into the app. Required before the first `expo prebuild`/EAS build.
RNMAPBOX_MAPS_DOWNLOAD_TOKEN=

# EAS project id, from `eas init` (only needed once you start building with EAS).
EAS_PROJECT_ID=
